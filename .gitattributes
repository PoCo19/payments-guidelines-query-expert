* text=auto
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.pptx binary
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
# Preserve byte-for-byte hashes of source packs and frozen evaluation records.
/data/** -text
/evaluation/*.json -text whitespace=cr-at-eol
/evaluation/*.sha256 -text
/output/midsem/evidence/** -text
/evaluation/ragas_runs/** -text whitespace=cr-at-eol
# Keep exact scoring-code bytes so saved hashes/resume checks survive cloning.
/evaluation/ragas_runner.py -text whitespace=cr-at-eol
/evaluation/ollama_judge.py -text whitespace=cr-at-eol

# Preserve frozen handoff checksums and original experiment bytes.
*.zip binary
/handoff/** -text whitespace=cr-at-eol
/config.handoff.json -text
/requirements-lock.txt -text
/evaluation/requirements-ragas-lock.txt -text
/models/reranker/manifest.json -text
/evaluation/payments_runs/** -text whitespace=cr-at-eol
/reports/** -text whitespace=cr-at-eol
/evaluation/** -text whitespace=cr-at-eol
/pilot/*.json -text whitespace=cr-at-eol
/source_repairs/** -text whitespace=-blank-at-eof,cr-at-eol
/config.workbench.json -text whitespace=cr-at-eol
/requirements-acquisition.txt -text
/query_policies.json -text
/source_quality_flags.json -text whitespace=cr-at-eol
# Preserve historical raw browser captures and patch artifacts verbatim.
/evaluation/ipo_regression_20261017/browser-final.txt -text whitespace=-blank-at-eol,cr-at-eol
/evaluation/quality_review_20261019/production.patch -text whitespace=-blank-at-eol,cr-at-eol
