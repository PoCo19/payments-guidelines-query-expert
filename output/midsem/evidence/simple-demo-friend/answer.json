        "draft_index": 2,
        "support_status": "automated_supported"
      },
      {
        "text": "Transactions must be processed through mobile devices having NFC capability.",
        "sources": [
          "S3"
        ],
        "draft_index": 3,
        "support_status": "automated_supported"
      },
      {
        "text": "Users must give permission to enable NFC for Tap & Pay transactions.",
        "sources": [
          "S14"
        ],
        "draft_index": 4,
        "support_status": "automated_supported"
      },
      {
        "text": "Explicit user consent is required after each device binding operation before allowing further transactions.",
        "sources": [
          "S4"
        ],
        "draft_index": 5,
        "support_status": "automated_supported"
      },
      {
        "text": "Users must give explicit consent for enabling the feature and have the ability to opt out at any time.",
        "sources": [
          "S5"
        ],
        "draft_index": 6,
        "support_status": "automated_supported"
      },
      {
