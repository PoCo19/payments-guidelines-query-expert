    "answer_blocks": [
      {
        "type": "paragraph",
        "claims": [
          {
            "text": "UPI Tap & Pay is a new mode of payment introduced for UPI transactions in addition to existing modes like Scan & Pay and Pay to Contact.",
            "sources": [
              "S13"
            ],
            "draft_index": 1,
            "support_status": "automated_supported"
          },
          {
            "text": "The feature is available on mobile devices with both Android and iOS operating systems.",
            "sources": [
              "S2"
            ],
            "draft_index": 2,
            "support_status": "automated_supported"
          },
          {
            "text": "Transactions must be processed through mobile devices having NFC capability.",
            "sources": [
              "S3"
            ],
            "draft_index": 3,
            "support_status": "automated_supported"
          },
          {
            "text": "Users must give permission to enable NFC for Tap & Pay transactions.",
            "sources": [
              "S14"
            ],
            "draft_index": 4,
            "support_status": "automated_supported"
          },
          {
            "text": "Explicit user consent is required after each device binding operation before allowing further transactions.",
            "sources": [
              "S4"
            ],
            "draft_index": 5,
            "support_status": "automated_supported"
          },
          {
            "text": "Users must give explicit consent for enabling the feature and have the ability to opt out at any time.",
            "sources": [
              "S5"
            ],
            "draft_index": 6,
            "support_status": "automated_supported"
          },
          {
            "text": "Transactions of Rs. 500 or less can be processed through a UPI LITE account if enabled by the user, otherwise with a UPI PIN.",
            "sources": [
              "S1"
            ],
            "draft_index": 7,
            "support_status": "automated_supported"
          },
          {
            "text": "Transactions exceeding Rs. 500 require a UPI PIN and are processed online.",
            "sources": [
              "S10"
            ],
            "draft_index": 8,
            "support_status": "automated_supported"
          }
        ]
      }
