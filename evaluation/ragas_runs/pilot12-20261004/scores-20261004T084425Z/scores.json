          "details": [
            {
              "value": 0.0,
              "reason": null,
              "claim": {
                "text": "The PDN exception in OC 207 applies only to NETC FASTag and RuPay NCMC.",
                "sources": [
                  "S1",
                  "S4"
                ],
                "draft_index": 1,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "UPI Members are directed to remove PDN validation for UPI Autopay execution only for the mentioned MCCs.",
                "sources": [
                  "S1"
                ],
                "draft_index": 2,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "The exception is not applicable to unrelated merchant categories as it is restricted to the intended purposes of NETC FASTag and RuPay NCMC.",
