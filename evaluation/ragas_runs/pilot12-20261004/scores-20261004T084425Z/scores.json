        "citation_support": {
          "status": "ok",
          "value": 0.95,
          "details": [
            {
              "value": 0.75,
              "reason": null,
              "claim": {
                "text": "OC 186A introduces UPI Tap & Pay on Point of Sale (PoS) terminals as an additional mode for initiating UPI transactions alongside QR.",
                "sources": [
                  "S1"
                ],
                "draft_index": 1,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "The enhancement enables Users to make contactless NFC-based UPI payments by unlocking their mobile device and tapping it on the PoS terminal.",
                "sources": [
                  "S1"
                ],
                "draft_index": 2,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 0.5,
              "reason": null,
              "claim": {
                "text": "UPI Tap & Pay transactions on PoS terminals are accepted only for Person-to-Merchant (P2M) transactions.",
                "sources": [
                  "S2"
                ],
                "draft_index": 3,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "Payee PSPs must enable UPI Tap & Pay only on NFC-enabled PoS terminals certified in accordance with PCI PTS / CPOC standards.",
                "sources": [
                  "S3"
                ],
                "draft_index": 4,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "UPI Application Providers and PSP Banks must obtain explicit User consent after each device binding operation before allowing further transactions.",
                "sources": [
                  "S4"
                ],
                "draft_index": 5,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "Members and UPI Application Providers must obtain explicit User consent for enabling the UPI Tap & Pay feature, with Users having the ability to opt out at any time.",
                "sources": [
                  "S6"
                ],
                "draft_index": 6,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "Payee PSPs shall integrate the Point-of-Sale Common Library for UPI (PoS CL) at the PoS terminal and complete integration on all terminals under its acquiring network.",
                "sources": [
                  "S7"
                ],
                "draft_index": 7,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "UPI Application Providers must ensure device lock is enabled as a prerequisite for activating UPI Tap & Pay, and the device shall be unlocked at the time of initiating a transaction.",
                "sources": [
                  "S8"
                ],
                "draft_index": 8,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "The per transaction limit for UPI Tap & Pay is capped at INR 5000, up to which additional factor of authentication shall not be required.",
                "sources": [
                  "S9"
                ],
                "draft_index": 9,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "UPI Application Providers must ensure UPI Tap & Pay is made available through a dedicated call-to-action and presented as a standalone feature not embedded within other services.",
                "sources": [
                  "S11"
                ],
                "draft_index": 10,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "Remitter Banks shall validate the User's account for UPI Tap & Pay feature enablement status before processing each transaction.",
                "sources": [
                  "S5"
                ],
                "draft_index": 11,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "Members and UPI Application Providers shall be consulted to provide an option to Users to set their own transaction limits within the INR 5000 ceiling.",
                "sources": [
                  "S5"
                ],
                "draft_index": 12,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "Settlement, reconciliation, dispute management, and Online Dispute Resolution for UPI Tap & Pay transactions must be carried out in accordance with extant UPI guidelines.",
                "sources": [
                  "S12"
                ],
                "draft_index": 13,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "Members shall be guided by RBI guidelines on Harmonization of Turn Around Time (TAT) and customer compensation for failed transactions using authorized Payment Systems.",
                "sources": [
                  "S13"
                ],
                "draft_index": 14,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "Members and UPI Application Providers shall refer to the applicable UPI Tap & Pay Feature Document, Technical Specifications and other instructions issued by NPCI for detailed requirements.",
                "sources": [
                  "S14"
                ],
                "draft_index": 15,
                "support_status": "automated_supported"
              }
            }
          ],
          "seconds": 109.453
        }
