          "value": 0.625,
          "details": [
            {
              "value": 0.0,
              "reason": null,
              "claim": {
                "text": "The limit for a linked RuPay Credit Card on UPI transactions is set to the lowest of three specific values.",
                "sources": [
                  "S2"
                ],
                "draft_index": 1,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 0.5,
              "reason": null,
              "claim": {
                "text": "One of these values is the RuPay Credit Card limit established by the card issuer.",
                "sources": [
                  "S1"
                ],
                "draft_index": 2,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "Another value is the limit imposed by the issuer for 'RuPay Credit Card on UPI' transactions based on their risk management framework.",
                "sources": [
                  "S1"
                ],
                "draft_index": 3,
                "support_status": "automated_supported"
              }
            },
            {
              "value": 1.0,
              "reason": null,
              "claim": {
                "text": "The third value is the limit set by the customer in accordance with the RBI circular on Enhancing Security of Card Transactions dated January 15, 2020.",
                "sources": [
                  "S1"
                ],
                "draft_index": 4,
                "support_status": "automated_supported"
              }
            }
          ],
          "seconds": 18.188
        }
      }
    },
